# Public business number, including country code, for example +91 followed by the number.
NEXT_PUBLIC_WHATSAPP_PHONE=
# Optional separate public call number; otherwise Call uses the WhatsApp number.
CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=it@example.com
RESEND_API_KEY=re_your_api_key_here

# Server-only AI provider key. Never expose provider credentials as NEXT_PUBLIC_*.
GROQ_API_KEY=
# Required for discovery in production: a dedicated random secret, at least 32 characters.
# Development uses an ephemeral key if absent; server restarts then invalidate sessions.
DISCOVERY_SESSION_SECRET=
DISCOVERY_MODEL=openai/gpt-oss-120b
# Set false to test guided fallback without making external AI calls.
DISCOVERY_AI_ENABLED=true
